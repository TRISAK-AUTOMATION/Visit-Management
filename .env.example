# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของบริษัท (ต้องติดตั้ง dotenv หรือกำหนดค่าผ่าน environment ของ server จริง)

# URL ของเว็บแอปที่ deploy จริง ใช้สร้างลิงก์ในอีเมล (อนุมัติ/ไม่อนุมัติ, ดูรายละเอียด)
APP_BASE_URL=https://visit.trisak.co.th

# ผู้ส่ง (From) ที่จะแสดงในอีเมล
MAIL_FROM="TRISAK Visit Management <no-reply@trisak.co.th>"

# (แนะนำ) ส่งผ่าน Brevo API - สร้าง key ที่ Brevo > SMTP & API > แท็บ "API keys & MCP" > Generate a new API key
# ถ้าตั้งค่านี้ ระบบจะส่งผ่าน API และไม่ใช้ค่า SMTP ด้านล่าง (อีเมลใน MAIL_FROM ต้องยืนยันเป็น Sender ใน Brevo แล้ว)
BREVO_API_KEY=

# ตั้งค่า SMTP Server ของบริษัท หรือใช้บริการ เช่น Gmail (App Password), Outlook365, SendGrid, Mailgun ฯลฯ
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@trisak.co.th
SMTP_PASS=your-app-password

# หมายเหตุ: ถ้าไม่ตั้งค่า SMTP_HOST ระบบจะไม่ส่งอีเมลจริง แต่จะ log ตัวอย่างอีเมลออก console แทน (โหมดพัฒนา)

# รหัสลับสำหรับเซ็น session (บังคับตั้งก่อนเปิดใช้งานจริง) — ใส่ข้อความสุ่มยาวๆ อย่างน้อย 32 ตัวอักษร และห้ามเผยแพร่
# สร้างค่าสุ่มได้ด้วยคำสั่ง: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ถ้าตั้ง NODE_ENV=production แล้วไม่ตั้งค่านี้ ระบบจะไม่ยอมเริ่มทำงาน
SESSION_SECRET=
